---
import Layout from '../layouts/Layout.astro';
import BlogCard from '../components/BlogCard.astro';
const pageTitle = "My Blog!❤️";
const posts = (await Astro.glob('./posts/*.md'))
  .filter(({ frontmatter }) => !frontmatter.draft)
  .map((post) => ({
    title: post.frontmatter.title,
    description: post.frontmatter.description,
    pubDate: post.frontmatter.pubDate,
    href: post.url,
  }))
  .sort(
    (a, b) => new Date(b.pubDate).getTime() - new Date(a.pubDate).getTime()
  );
---

<Layout pageTitle={pageTitle}>
  <p class="blog-page-intro">
    For a long time, I’ve yearned for a space to share the thoughts that dance through my mind —
    whether it’s pondering the meaning of life or questioning why hot food feels like a hug.
    This blog is my attempt to blur the lines between the personal, academic, and professional.
    Welcome to a little corner of myself. 🌸
  </p>

  {posts.map((post) => (
    <BlogCard
      blogPath={post.href}
      blogTitle={post.title}
      date={post.pubDate}
    >
      <p class="blog-post-card">{post.description}</p>
    </BlogCard>
  ))}
</Layout>
