---
import Layout from '../layouts/Layout.astro';
const pageTitle = "Luisa (Ellie) Escobar-Robledo";
const latestResearch = [
  { title: 'TBD', link: '/research/publications' },
];

const latestPosts = [
  { title: 'Para ti que me conociste de antes', link: '/blog/conociste_de_antes' },
  { title: 'Here I am', link: '/blog/here-i-am' },
];
---

<Layout pageTitle={pageTitle}>
    <section class="hero-section">
        <img class="hero-portrait" src="/EllieCompBio/images/WebsiteHeadshot.jpg" alt="Ellie Escobar-Robledo headshot" width="200" />
        <div class="hero-copy">
            <h1 class="hero-greeting">Hi, I'm Ellie 🌸</h1>
            <p>Welcome to my little corner of the internet. I'm a physician-scientist building tools to explore the heart, blending data science, medicine, and computational biology.</p>
        </div>
    </section>

    <section class="marker-grid">
        <div class="marker-card marker-blue">
            <h2>🔬 Latest Research</h2>
            <ul>
            {latestResearch.map(item => (
                <li><a href={item.link}>{item.title}</a></li>
            ))}
            </ul>
        </div>

        <div class="marker-card marker-pink">
            <h2>📝 Latest Posts</h2>
            <ul>
            {latestPosts.map(post => (
                <li><a href={post.link}>{post.title}</a></li>
            ))}
            </ul>
        </div>
    </section>
</Layout>
